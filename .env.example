# === AtelierVitre — modele de configuration ===
# Copier en .env puis adapter :  cp .env.example .env
# (.env est ignore par git, voir .gitignore)
# NB: ne pas mettre de caractere '#' dans une valeur (il demarre un commentaire
#     et tronque la valeur). Pour SECRET_KEY, utiliser un alphabet sans '#'.

SECRET_KEY=changeme-genere-une-cle-secrete-sans-diese
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DATABASE_URL=postgresql://candidato:candidato@127.0.0.1:5432/candidato
REDIS_URL=redis://127.0.0.1:6379/0

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=contact@ateliervitre.fr

